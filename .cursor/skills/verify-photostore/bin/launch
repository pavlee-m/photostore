#!/usr/bin/env bash
set -euo pipefail

# Start an isolated Photostore stack for verification. Never attaches to a
# stack this helper did not create.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/common.sh"

mkdir -p "$RUN_DIR" "$EVIDENCE_DIR"
require_repo_env

if [[ -f "$STATE_FILE" ]]; then
	# shellcheck disable=SC1090
	source "$STATE_FILE"
	API_URL="http://127.0.0.1:${APP_PORT}"
	APP_URL="http://127.0.0.1:${FRONTEND_PORT}"
	if [[ -n "${FRONTEND_PID:-}" ]] && kill -0 "$FRONTEND_PID" 2>/dev/null \
		&& http_ok "$APP_URL/" 30 \
		&& [[ "$(http_code "$API_URL/api/v1/founder/exists-founder")" == "200" ]]; then
		echo "launch: reusing healthy verify instance at $APP_URL (api $API_URL)"
		echo "COMPOSE_PROJECT=$COMPOSE_PROJECT"
		echo "FRONTEND_PID=$FRONTEND_PID"
		exit 0
	fi
	echo "launch: stale state found; run cleanup before launching again." >&2
	exit 1
fi

for label_port in "frontend:$FRONTEND_PORT" "api:$APP_PORT" "mssql:$MSSQL_PORT"; do
	label="${label_port%%:*}"
	port="${label_port##*:}"
	owners="$(port_pids "$port" || true)"
	if [[ -n "$owners" ]]; then
		echo "launch: refusing to share $label port $port (pids: $owners)." >&2
		echo "Stop that listener or pick another port. Do not drive a stack you did not start." >&2
		exit 1
	fi
done

if ! command -v docker >/dev/null || ! docker compose version >/dev/null; then
	echo "launch: docker compose is required." >&2
	exit 1
fi
if ! command -v bun >/dev/null; then
	echo "launch: bun is required for the frontend." >&2
	exit 1
fi

echo "launch: starting compose project $COMPOSE_PROJECT (api :$APP_PORT, mssql :$MSSQL_PORT)"
APP_PORT="$APP_PORT" MSSQL_PORT="$MSSQL_PORT" compose --env-file "$REPO_ROOT/.env" up --build -d
FRONTEND_PID=""
write_state

echo "launch: waiting for API at $API_URL/api/v1/founder/exists-founder"
deadline=$((SECONDS + 900))
while ((SECONDS < deadline)); do
	if [[ "$(http_code "$API_URL/api/v1/founder/exists-founder")" == "200" ]]; then
		break
	fi
	sleep 3
done
if [[ "$(http_code "$API_URL/api/v1/founder/exists-founder")" != "200" ]]; then
	echo "launch: API did not become ready within 15 minutes." >&2
	compose logs --tail 80 photostore >&2 || true
	exit 1
fi

if [[ ! -d "$REPO_ROOT/frontend/node_modules" ]]; then
	echo "launch: bun install in frontend/"
	(cd "$REPO_ROOT/frontend" && bun install)
fi

echo "launch: starting frontend at $APP_URL (proxy $API_URL)"
: >"$RUN_DIR/frontend.log"
(
	cd "$REPO_ROOT/frontend"
	exec setsid env VITE_DEV_API_PROXY="$API_URL" bun --bun x vite dev --host 127.0.0.1 --port "$FRONTEND_PORT"
) </dev/null >"$RUN_DIR/frontend.log" 2>&1 &
FRONTEND_PID=$!
write_state
# Leave the Vite process in its own session so launch exiting does not SIGHUP it.
disown "$FRONTEND_PID" 2>/dev/null || true

deadline=$((SECONDS + 180))
while ((SECONDS < deadline)); do
	if ! kill -0 "$FRONTEND_PID" 2>/dev/null; then
		echo "launch: frontend process $FRONTEND_PID exited." >&2
		tail -n 80 "$RUN_DIR/frontend.log" >&2 || true
		exit 1
	fi
	if grep -q "Local:" "$RUN_DIR/frontend.log" 2>/dev/null && http_ok "$APP_URL/" 60; then
		echo "launch: ready"
		echo "APP_URL=$APP_URL"
		echo "API_URL=$API_URL"
		echo "FRONTEND_PID=$FRONTEND_PID"
		echo "COMPOSE_PROJECT=$COMPOSE_PROJECT"
		echo "VERIFY_FOUNDER_EMAIL=$VERIFY_FOUNDER_EMAIL"
		exit 0
	fi
	sleep 1
done

echo "launch: frontend did not become ready (last HTTP $(http_code "$APP_URL/" 10))." >&2
tail -n 80 "$RUN_DIR/frontend.log" >&2 || true
exit 1
