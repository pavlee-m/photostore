#!/usr/bin/env bash
set -euo pipefail

# Read-only health check: is this verify instance ours, and is it worth driving?

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/common.sh"

ok=1
fail() {
	echo "doctor: FAIL $*" >&2
	ok=0
}

if [[ ! -f "$STATE_FILE" ]]; then
	fail "no $STATE_FILE — this helper did not start an instance. Run launch."
	exit 1
fi

# shellcheck disable=SC1090
source "$STATE_FILE"
API_URL="http://127.0.0.1:${APP_PORT}"
APP_URL="http://127.0.0.1:${FRONTEND_PORT}"

echo "APP_URL=$APP_URL"
echo "API_URL=$API_URL"
echo "COMPOSE_PROJECT=$COMPOSE_PROJECT"
echo "FRONTEND_PID=${FRONTEND_PID:-}"
echo "VERIFY_FOUNDER_EMAIL=${VERIFY_FOUNDER_EMAIL:-}"

if [[ -z "${FRONTEND_PID:-}" ]] || ! kill -0 "$FRONTEND_PID" 2>/dev/null; then
	fail "frontend pid ${FRONTEND_PID:-unset} is not running"
else
	echo "frontend_process=up"
	owner="$(port_owned_by_tree "$FRONTEND_PORT" "$FRONTEND_PID" || true)"
	if [[ -z "$owner" ]]; then
		fail "port $FRONTEND_PORT is not owned by frontend pid $FRONTEND_PID or its children (owners: $(port_pids "$FRONTEND_PORT" || echo none))"
	else
		echo "frontend_port_owner=$owner"
	fi
fi

if ! compose ps --status running --services 2>/dev/null | grep -qx photostore; then
	fail "compose service photostore is not running in project $COMPOSE_PROJECT"
else
	echo "compose_photostore=up"
fi
if ! compose ps --status running --services 2>/dev/null | grep -qx mssql; then
	fail "compose service mssql is not running in project $COMPOSE_PROJECT"
else
	echo "compose_mssql=up"
fi

api_code="$(http_code "$API_URL/api/v1/founder/exists-founder")"
if [[ "$api_code" != "200" ]]; then
	fail "API founder probe returned HTTP $api_code (expected 200)"
else
	exists="$(founder_exists_body)"
	echo "founder_exists=$exists"
	echo "api=ok"
fi

app_code="$(http_code "$APP_URL/" 30)"
if ! http_ok "$APP_URL/" 30; then
	fail "frontend returned HTTP $app_code (expected 200 or a redirect)"
else
	echo "frontend=ok"
fi

if ((ok == 0)); then
	echo "doctor: instance is not safe to drive"
	exit 1
fi
echo "doctor: ok"
